{
  "name": "@valaxyjs/monorepo",
  "type": "module",
  "version": "1.0.0-rc.15",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "📄 Vite & Vue powered static blog generator.",
  "author": {
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "repository": "git+https://github.com/YunYouJun/valaxy.git",
  "keywords": [
    "vite",
    "vue",
    "blog"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "verify:api": "node scripts/verify-api-migration.mjs",
    "build:all": "pnpm -r --filter \"./packages/**\" run build",
    "build": "pnpm run build:@valaxyjs/utils && pnpm run build:valaxy && pnpm run build:devtools",
    "build:@valaxyjs/utils": "pnpm -C packages/@valaxyjs/utils run build",
    "build:create-valaxy": "pnpm -C packages/create-valaxy run build",
    "build:valaxy": "pnpm -C packages/valaxy run build",
    "build:demo": "pnpm -C demo/yun run build",
    "build:demo:ssg": "pnpm -C demo/yun run build:ssg",
    "build:cf:docs": "tsx scripts/build-cf-docs.ts",
    "build:docs": "pnpm run docs:build",
    "build:devtools": "pnpm -C packages/devtools run build",
    "clean": "pnpm -r --filter \"./packages/**\" run clean",
    "cli:debug": "tsx packages/valaxy/node/cli/index.ts debug",
    "ci": "pnpm run build && pnpm build:create-valaxy && node packages/create-valaxy/dist/index.mjs -y",
    "ci:publish": "pnpm -r publish --access public --no-git-checks",
    "create:start": "pnpm -C packages/create-valaxy run start",
    "custom": "pnpm -C demo/custom run dev",
    "demo": "pnpm run demo:yun",
    "demo:build": "pnpm -C demo/yun run build",
    "demo:serve": "pnpm -C demo/yun run serve",
    "demo:yun": "pnpm -C demo/yun run dev",
    "demo:vite": "pnpm -C demo/yun run vite:dev",
    "dev:lib": "pnpm -C packages/valaxy run dev",
    "dev": "pnpm -r --filter \"./packages/**\" --filter=\"!./packages/devtools\" --parallel run dev",
    "devtools": "pnpm -C packages/devtools run dev",
    "devtools:client": "pnpm -C packages/devtools run dev:client",
    "docs": "pnpm -C docs run dev",
    "docs:dev": "pnpm -C docs run dev:debug",
    "docs:build": "pnpm -C docs run build",
    "docs:serve": "pnpm -C docs run serve",
    "docs:vitepress": "pnpm -C docs run vitepress:dev",
    "e2e": "playwright test",
    "e2e:ssg": "playwright test --config playwright.ssg.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "link:dev": "pnpm add --global ./packages/valaxy",
    "lint": "eslint .",
    "stylelint": "stylelint --fix \"**/*.{scss,vue}\"",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "release": "tsx scripts/release.ts",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "test": "vitest",
    "test:devtools": "tsx scripts/check-devtools-addons.ts",
    "test:e2e": "pnpm run e2e",
    "test:space": "cross-env NODE_OPTIONS=--max-old-space-size=2304 pnpm -C demo/yun run build:ssg",
    "test:space:docs": "cross-env NODE_OPTIONS=--max-old-space-size=1536 pnpm -C docs run build",
    "validate:addons": "tsx scripts/validate-addon-docs.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@valaxyjs/devtools": "workspace:*",
    "valaxy": "workspace:*",
    "valaxy-addon-algolia": "workspace:*",
    "valaxy-addon-components": "workspace:*",
    "valaxy-addon-lightgallery": "workspace:*",
    "valaxy-addon-test": "workspace:*",
    "valaxy-addon-twikoo": "workspace:*",
    "valaxy-addon-waline": "workspace:*",
    "valaxy-theme-press": "workspace:*",
    "valaxy-theme-yun": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@iconify-json/logos": "catalog:build",
    "@iconify-json/vscode-icons": "catalog:build",
    "@microsoft/api-extractor": "catalog:",
    "@playwright/test": "catalog:",
    "@types/debug": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/prompts": "catalog:",
    "@vitejs/devtools-vite": "catalog:",
    "@vitejs/devtools-vitest": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/ui": "catalog:",
    "bumpp": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "https-localhost": "catalog:",
    "husky": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "npm-run-all": "catalog:",
    "postcss": "catalog:",
    "postcss-html": "catalog:",
    "prompts": "catalog:",
    "rimraf": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-html": "catalog:",
    "stylelint-config-recommended": "catalog:",
    "stylelint-config-recommended-scss": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard-scss": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:build",
    "unbuild": "catalog:build",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "zx": "catalog:build"
  },
  "lint-staged": {
    "{packages,demo,scripts}/**/*.{js,ts,vue,json,yml}": [
      "eslint --fix"
    ]
  }
}
