{
  "name": "@valaxyjs/devtools",
  "type": "module",
  "version": "1.0.0-rc.12",
  "description": "DevTools for Valaxy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/valaxy.git",
    "directory": "packages/devtools"
  },
  "keywords": [
    "valaxy",
    "devtools"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./rpc": "./rpc.d.ts",
    "./definition": {
      "types": "./dist/node/definition.d.ts",
      "default": "./dist/node/definition.mjs"
    },
    "./mcp": {
      "types": "./dist/node/mcp.d.ts",
      "default": "./dist/node/mcp.mjs"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "default": "./dist/page.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.mjs"
    },
    "./client-api": {
      "types": "./dist/client-api.d.ts",
      "default": "./dist/client-api.mjs"
    },
    "./client": "./dist/client",
    "./*": "./*"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "rpc.d.ts"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && pnpm run build:client && pnpm run build:node",
    "build:client": "vite build src/client",
    "build:node": "unbuild",
    "dev": "pnpm run dev:client",
    "dev:client": "vite dev src/client --port 5001",
    "watch:client": "vite build src/client --watch",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp && pnpm publish"
  },
  "dependencies": {
    "@devframes/agentic": "catalog:",
    "@devframes/service-shiki": "catalog:",
    "@valaxyjs/utils": "workspace:*",
    "@vitejs/devtools-kit": "catalog:",
    "consola": "catalog:build",
    "cross-spawn": "catalog:",
    "dayjs": "catalog:",
    "devframe": "catalog:",
    "fast-glob": "catalog:",
    "fs-extra": "catalog:",
    "gray-matter": "catalog:",
    "h3": "catalog:",
    "js-yaml": "catalog:",
    "magicast": "catalog:",
    "pathe": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@antfu/design": "catalog:",
    "@iconify-json/ph": "catalog:build",
    "@iconify-json/ri": "catalog:build",
    "@intlify/unplugin-vue-i18n": "catalog:build",
    "@types/cross-spawn": "catalog:",
    "@types/splitpanes": "catalog:",
    "@types/wicg-file-system-access": "catalog:",
    "@unocss/reset": "catalog:",
    "@vitejs/devtools": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "colorjs.io": "catalog:build",
    "pinia": "catalog:",
    "reka-ui": "catalog:frontend",
    "splitpanes": "catalog:",
    "typescript": "catalog:build",
    "unbuild": "catalog:build",
    "unocss": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:build",
    "vite-plugin-vue-devtools": "catalog:",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:build",
    "vue-router": "catalog:"
  }
}
