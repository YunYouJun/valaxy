{
  "name": "valaxy-docs",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm run build:ssg",
    "build:spa": "valaxy build",
    "build:ssg": "valaxy build --ssg --log=info",
    "dev": "nodemon -w \"../packages/valaxy/dist/*.js\" --exec \"valaxy .\"",
    "dev:debug": "nodemon -w \"../packages/valaxy/dist/*.js\" --exec \"valaxy . --log debug\"",
    "rss": "valaxy rss",
    "serve": "vite preview"
  },
  "dependencies": {
    "reka-ui": "catalog:frontend",
    "valaxy": "link:../packages/valaxy",
    "valaxy-addon-algolia": "link:../packages/valaxy-addon-algolia",
    "valaxy-addon-components": "workspace:*",
    "valaxy-addon-girls": "workspace:*",
    "valaxy-addon-git-log": "catalog:",
    "valaxy-addon-meting": "workspace:*",
    "valaxy-addon-typedoc": "workspace:*",
    "valaxy-theme-press": "link:../packages/valaxy-theme-press"
  },
  "devDependencies": {
    "@iconify-json/carbon": "catalog:build",
    "@iconify-json/simple-icons": "catalog:build",
    "markdown-it-mathjax3": "catalog:",
    "nodemon": "catalog:",
    "vite": "catalog:build"
  }
}
